# Axiom API key used by the server-side proxy (Vite dev proxy locally, the
# Vercel function in production). Never exposed to the browser.
AXIOM_API_KEY=

# Optional: override the upstream Axiom API base (defaults to the production
# deployment at https://axiom-api-eta.vercel.app/v1).
# AXIOM_API_BASE=https://axiom-api-eta.vercel.app/v1

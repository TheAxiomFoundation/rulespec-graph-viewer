{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/", "destination": "https://axiom.org/graph-viewer", "permanent": true }
  ],
  "rewrites": [
    { "source": "/graph-viewer/api/:path*", "destination": "/api/:path*" },
    { "source": "/api/axiom/:path*", "destination": "/api/axiom" },
    { "source": "/graph-viewer/:path*", "destination": "/:path*" }
  ]
}
